{
  "name": "wm-browseragent",
  "displayName": "WM BrowserAgent",
  "version": "0.1.0",
  "description": "BrowserAgent — AI chat & web automation via browser sidepanel",
  "author": "page-assist",
  "type": "module",
  "scripts": {
    "dev": "cross-env TARGET=chrome wxt",
    "dev:firefox": "cross-env TARGET=firefox wxt -b firefox",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "cross-env TARGET=chrome wxt build",
    "build:firefox": "cross-env TARGET=firefox wxt build -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@plasmohq/storage": "^1.9.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "cheerio": "^1.0.0-rc.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.10",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "i18next": "^23.10.1",
    "marked": "^15.0.12",
    "ml-distance": "^4.0.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-i18next": "^14.1.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.0.280",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "cross-env": "^7.0.3",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "5.3.3",
    "vitest": "^3.0.0",
    "wxt": "^0.19.6"
  }
}
